# Copy to .env to override the local defaults in docker-compose.yml.
# .env is gitignored. Never commit real credentials.
MSSQL_SA_PASSWORD=LocalDevOnly123
API_KEY=dev-key

# Variable names every service reads (set as Container App env vars/secrets on Azure):
# SERVICE_NAME   expenses | settlements
# DATABASE_URL   SQLAlchemy URL, mssql+pyodbc://...  (secret on Azure)
# API_KEY        shared demo key sent as X-API-Key   (secret on Azure)
# CORS_ORIGIN    the Static Web App URL
# EXPENSES_URL   settlements only: base URL of expenses-service
